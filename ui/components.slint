import { Theme, Fmt, MeetingItem } from "globals.slint";

export component Icon inherits Image {
    in property <brush> tint: Theme.text;
    colorize: root.tint;
    width: 18px;
    height: 18px;
    image-fit: contain;
}

// kind: 0 = primary, 1 = secondary, 2 = ghost, 3 = danger
export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <int> kind: 0;
    callback clicked();

    private property <color> bg-normal: root.kind == 0 ? Theme.accent : root.kind == 3 ? Theme.danger : root.kind == 1 ? Theme.surface-2 : transparent;
    private property <color> bg-hover: root.kind == 0 ? Theme.accent-hover : root.kind == 3 ? #fb8f8f : root.kind == 1 ? #28303b : Theme.surface-2;
    private property <color> fg: root.kind == 0 || root.kind == 3 ? #ffffff : Theme.text;

    height: 38px;
    min-width: layout.min-width;
    border-radius: 9px;
    border-width: root.kind == 1 ? 1px : 0px;
    border-color: Theme.border-strong;
    background: !root.enabled ? root.bg-normal : ta.pressed ? root.bg-normal.darker(0.2) : ta.has-hover ? root.bg-hover : root.bg-normal;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: 120ms; }

    layout := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.fg;
                width: 16px;
                height: 16px;
            }
        }

        Text {
            text: root.text;
            color: root.fg;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: ta.has-hover && root.enabled ? Theme.surface-2 : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Icon {
        source: root.icon;
        tint: ta.has-hover ? Theme.text : Theme.muted;
        width: 16px;
        height: 16px;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> inner-padding: 20px;

    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: root.inner-padding;
        spacing: 16px;

        if root.title != "": VerticalLayout {
            spacing: 4px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 650;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        @children
    }
}

export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;

    spacing: 7px;
    horizontal-stretch: 1;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 600;
    }

    @children

    if root.hint != "": Text {
        text: root.hint;
        color: Theme.dim;
        font-size: 11px;
        wrap: word-wrap;
    }
}

export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    in property <string> badge;
    in property <color> badge-color: Theme.accent;
    callback clicked();

    height: 40px;
    border-radius: 9px;
    background: root.active ? Theme.accent.with-alpha(0.13) : ta.has-hover ? Theme.surface-2 : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.active ? Theme.accent : Theme.muted;
            }
        }

        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: root.active ? Theme.text : Theme.muted;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
        }

        if root.badge != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                min-width: 18px;
                border-radius: 9px;
                background: root.badge-color.with-alpha(0.2);
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.badge;
                        font-size: 10px;
                        font-weight: 700;
                        color: root.badge-color;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    Rectangle {
        x: 0px;
        width: 3px;
        height: root.active ? 18px : 0px;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: 150ms; easing: ease-out; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Tick inherits Rectangle {
    in property <bool> checked;
    in property <bool> partial;
    in property <bool> enabled: true;
    callback toggled();

    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: root.checked || root.partial ? Theme.accent : transparent;
    border-width: root.checked || root.partial ? 0px : 1.5px;
    border-color: ta.has-hover && root.enabled ? Theme.muted : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 100ms; }

    if root.checked: Icon {
        source: @image-url("icons/check.svg");
        tint: #ffffff;
        width: 13px;
        height: 13px;
    }

    if root.partial && !root.checked: Rectangle {
        width: 9px;
        height: 2px;
        border-radius: 1px;
        background: #ffffff;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.muted;

    height: 22px;
    border-radius: 11px;
    background: root.tone.with-alpha(0.13);

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 10px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.tone;
            }
        }

        Text {
            text: root.text;
            color: root.tone;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component Bar inherits Rectangle {
    in property <float> value;
    in property <color> tone: Theme.accent;
    in property <color> tone-end: Theme.accent-2;

    height: 6px;
    border-radius: self.height / 2;
    background: Theme.surface-2;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        height: parent.height;
        width: parent.width * min(max(root.value, 0), 1);
        border-radius: parent.border-radius;
        background: @linear-gradient(90deg, root.tone 0%, root.tone-end 100%);
        animate width { duration: 300ms; easing: ease-out; }
    }
}

export component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> accent: Theme.accent;
    in property <image> icon;

    height: 78px;
    horizontal-stretch: 1;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 16px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 11px;
                background: root.accent.with-alpha(0.13);
                Icon {
                    source: root.icon;
                    tint: root.accent;
                    width: 20px;
                    height: 20px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.value;
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: root.label;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked();

    height: 30px;
    border-radius: 15px;
    background: root.active ? Theme.accent.with-alpha(0.16) : ta.has-hover && root.enabled ? Theme.surface-2 : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.accent : ta.has-hover && root.enabled ? Theme.accent.with-alpha(0.6) : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: root.active || ta.has-hover ? Theme.text : Theme.muted;
            font-size: 12px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component DateField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    callback clicked();

    height: 44px;
    min-width: 168px;
    border-radius: 9px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? Theme.accent : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.5;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 11px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/calendar.svg");
                tint: Theme.accent;
                width: 17px;
                height: 17px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.label;
                font-size: 10px;
                font-weight: 600;
                color: Theme.dim;
            }

            Text {
                text: root.value;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component MeetingRow inherits Rectangle {
    in property <MeetingItem> item;
    in property <bool> interactive: true;
    callback toggle();
    callback open();

    height: 66px;
    background: row-ta.has-hover ? Theme.surface-hover : transparent;

    row-ta := TouchArea {
        enabled: root.interactive;
        clicked => {
            root.toggle();
        }
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 14px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Tick {
                checked: root.item.selected;
                enabled: root.interactive;
                toggled => {
                    root.toggle();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: Fmt.status-color(root.item.status).with-alpha(0.12);
                Icon {
                    source: @image-url("icons/video.svg");
                    tint: Fmt.status-color(root.item.status);
                    width: 18px;
                    height: 18px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.item.topic;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.item.date + "   ·   " + root.item.time + "   ·   " + root.item.duration + (root.item.files > 1 ? "   ·   " + root.item.files + " files" : "");
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 84px;
            Text {
                text: root.item.size;
                color: Theme.muted;
                font-size: 12px;
                horizontal-alignment: right;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 6px;
            width: 170px;

            HorizontalLayout {
                alignment: start;
                Pill {
                    text: root.item.status-label;
                    tone: Fmt.status-color(root.item.status);
                }
            }

            if root.item.status == "downloading": Bar {
                value: root.item.progress;
                height: 4px;
            }

            if root.item.detail != "" && root.item.status != "downloading": Text {
                text: root.item.detail;
                color: root.item.status == "failed" ? Theme.danger : Theme.dim;
                font-size: 10px;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 32px;
            if root.item.can-open: IconButton {
                icon: @image-url("icons/folder.svg");
                clicked => {
                    root.open();
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}
